---
import ThemeToggle from './ThemeToggle.vue';

const BASE = import.meta.env.BASE_URL;
// 构建时 pathname 带 base 前缀（如 /tool-hub/），剥离后再做导航高亮匹配
const rawPath = Astro.url.pathname;
const currentPath = rawPath.startsWith(BASE) ? `/${rawPath.slice(BASE.length)}` : rawPath;

// 「全部工具」指向首页工具箱总览锚点（原 /tools/ 列表页已下线，仅保留跳转）
const navLinks = [
  { href: '/', label: '首页', match: (p: string) => p === '/' },
  { href: `${BASE}#tool-catalog`, label: '全部工具', match: (p: string) => p.startsWith('/tools/') },
  { href: '/about/', label: '关于', match: (p: string) => p.startsWith('/about') },
];
---

<header class="glass border-b border-gray-200 dark:border-slate-800 sticky top-0 z-50 shadow-sm dark:shadow-none">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-gray-900 dark:text-white hover:text-accent dark:hover:text-accent-light transition-colors flex items-center gap-2">
      <!-- Logo：模块矩阵（工具集合，右上虚线块表示持续新增） -->
      <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="8" height="8" rx="2.2" fill="currentColor" />
        <rect x="3" y="13" width="8" height="8" rx="2.2" fill="currentColor" />
        <rect x="13" y="13" width="8" height="8" rx="2.2" fill="currentColor" />
        <rect x="13.8" y="3.8" width="6.4" height="6.4" rx="1.9" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.6 2.1" opacity=".55" />
      </svg>
      ToolHub
    </a>

    <!-- Desktop Nav + Theme Toggle -->
    <div class="flex items-center gap-6">
      <ul class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors',
                link.match(currentPath)
                  ? 'text-accent-dark dark:text-accent'
                  : 'text-gray-700 dark:text-slate-300 hover:text-accent-dark dark:hover:text-white',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Theme Toggle -->
      <div class="hidden md:block">
        <ThemeToggle client:load />
      </div>

      <!-- Mobile Nav Toggle -->
      <button
        id="menu-toggle"
        class="md:hidden text-gray-700 dark:text-slate-300 hover:text-accent dark:hover:text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-slate-800">
    <ul class="px-6 py-4 space-y-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block text-sm font-medium transition-colors',
              link.match(currentPath)
                ? 'text-accent-dark dark:text-accent'
                : 'text-gray-700 dark:text-slate-300 hover:text-accent-dark dark:hover:text-white',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <!-- Mobile Theme Toggle -->
      <li class="pt-3 border-t border-gray-200 dark:border-slate-700">
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-700 dark:text-slate-400 font-medium">主题切换</span>
          <ThemeToggle client:load />
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
