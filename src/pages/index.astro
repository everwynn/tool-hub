---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCatalog from '../components/tools/HomeCatalog.vue';
import { tools, availableCount, categoryMeta } from '../data/tools';
---

<BaseLayout title="ToolHub - 在线开发工具箱" description={`${availableCount} 个纯前端开发工具，覆盖编码转换、文本格式、时间随机、图片工具、安全加密、运维部署、开发辅助 7 大分类，全部在浏览器本地运行，数据不上传`}>
  <!-- Hero（居中） -->
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-0 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent-dark dark:text-accent text-sm font-medium">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      纯前端 · 零后端 · 数据不上传
    </div>
    <h1 class="mt-5 text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight tracking-tight">
      在线工具箱
    </h1>
    <p class="mt-4 mx-auto max-w-[620px] text-base md:text-lg text-gray-600 dark:text-slate-400 leading-relaxed">
      <strong class="text-accent-dark dark:text-accent font-semibold">{availableCount} 个工具</strong> · <strong class="text-accent-dark dark:text-accent font-semibold">{categoryMeta.length} 大分类</strong>，覆盖编码转换、文本处理、图片、安全、运维等场景，全部在浏览器本地运行。
    </p>
    <div class="mt-5 flex justify-center gap-10">
      <div>
        <div class="text-xl font-bold text-gray-900 dark:text-white">{availableCount}</div>
        <div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">可用工具</div>
      </div>
      <div>
        <div class="text-xl font-bold text-gray-900 dark:text-white">{categoryMeta.length}</div>
        <div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">个分类</div>
      </div>
      <div>
        <div class="text-xl font-bold text-gray-900 dark:text-white">0</div>
        <div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">数据上传</div>
      </div>
      <div>
        <div class="text-xl font-bold text-gray-900 dark:text-white">100%</div>
        <div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">本地运行</div>
      </div>
    </div>
  </section>

  <!-- 搜索框 + 常用链接 + 分类总览 + 分组工具列表 -->
  <section class="max-w-6xl mx-auto px-6 pt-7 pb-20">
    <HomeCatalog client:load tools={tools} categories={categoryMeta} total={availableCount} />
  </section>
</BaseLayout>
