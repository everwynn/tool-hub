---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageCompressor from '../../components/tools/ImageCompressor.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="图片压缩/格式转换 - ToolHub" description="在线压缩图片并转换为 WebP / JPEG / PNG，支持质量调节与尺寸缩放，浏览器本地处理不上传">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="image-compressor" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🖼️</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-800">图片工具</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">图片压缩 / 格式转换</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">浏览器本地压缩图片，支持 WebP / JPEG / PNG 格式转换、质量调节与尺寸缩放，实时对比压缩前后体积，数据不上传。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['图片压缩', 'WebP', 'JPEG', 'PNG', '本地处理'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <ImageCompressor client:load />
  </article>
</BaseLayout>
