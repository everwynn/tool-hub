---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WatermarkRemover from '../../components/tools/WatermarkRemover.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="AI 图片去水印 - ToolHub" description="基于 LaMa AI 模型，浏览器端本地修复图片水印，涂抹标记后一键去除，数据不上传">
  <article class="max-w-7xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="watermark" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🖌️</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-800">图片工具</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 数据不上传</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">AI 图片去水印（待测）</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">基于 LaMa（Large Mask Inpainting）AI 模型，在浏览器端智能修复图片水印区域。只需用画笔涂抹标记水印，AI 会根据周围内容自动填充修复，全程本地运算，图片不上传。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['AI修复', 'LaMa模型', '画笔标记', '浏览器推理', 'ONNX', '数据不上传'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <WatermarkRemover client:load />
  </article>
</BaseLayout>
