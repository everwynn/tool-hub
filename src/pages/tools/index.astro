---
// 该页已下线：原「全部工具」列表页与首页工具箱总览功能重复，
// 保留本页仅作老链接保底，自动跳转到首页工具箱总览锚点。
const BASE = import.meta.env.BASE_URL;
const target = `${BASE}#tool-catalog`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>全部工具 - ToolHub</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p style="font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; padding: 64px 24px; text-align: center; color: #6b7280; font-size: 14px; line-height: 2;">
      工具箱已迁移至首页<br />
      <a href={target} style="color: #059669;">正在跳转…点此手动前往</a>
    </p>
  </body>
</html>
