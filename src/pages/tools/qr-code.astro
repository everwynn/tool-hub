---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QrCodeGenerator from '../../components/tools/QrCodeGenerator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="二维码生成器 - ToolHub" description="在线二维码生成器，支持自定义颜色、纠错级别、模块大小，导出 PNG/SVG">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="qr-code" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">📱</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">时间随机</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">二维码生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">输入文本/URL/WiFi/名片等，自定义颜色、纠错级别、模块大小，支持导出 PNG 和 SVG 格式。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['QR Code', 'PNG/SVG 导出', '纠错级别', '自定义颜色', 'WiFi/名片/URL'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <QrCodeGenerator client:load />
  </article>
</BaseLayout>
