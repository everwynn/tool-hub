---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UuidGenerator from '../../components/tools/UuidGenerator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="UUID 生成器 - ToolHub" description="在线批量生成 UUID v4/v1/Nil，支持大写、连字符、花括号格式，crypto.randomUUID 本地生成">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="uuid" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🆔</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">时间随机</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">UUID 生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">批量生成 UUID v4（随机）、v1（时间戳）、Nil UUID，支持大写、连字符、花括号等格式，使用 crypto API 本地生成。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['UUID v4', 'UUID v1', 'Nil UUID', '批量生成', 'crypto.randomUUID'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <UuidGenerator client:load />
  </article>
</BaseLayout>
