---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PasswordGenerator from '../../components/tools/PasswordGenerator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="密码生成器 - ToolHub" description="在线随机密码生成器，使用 crypto.getRandomValues 安全随机数，强度评估，自定义字符集">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="password-generator" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔑</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">时间随机</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 数据不上传</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">随机密码生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">使用 crypto.getRandomValues 安全随机数生成器，可自定义长度、字符集（大小写/数字/符号），实时强度评估和熵值估算。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['crypto.getRandomValues', '强度评估', '熵值估算', '排除歧义字符', '4-64 位'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <PasswordGenerator client:load />
  </article>
</BaseLayout>
