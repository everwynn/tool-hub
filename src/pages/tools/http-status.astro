---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HttpStatus from '../../components/tools/HttpStatus.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="HTTP 状态码速查 - ToolHub" description="快速查询 HTTP 状态码含义，含详细说明、使用场景，支持分类筛选和关键词搜索">
  <article class="max-w-4xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="http-status" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">📡</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">Web 开发</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯静态</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">HTTP 状态码速查</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">覆盖 1xx～5xx 所有常用状态码，含中文说明、使用场景、与相似状态码的区别解析。支持分类筛选和关键词搜索。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['1xx 信息', '2xx 成功', '3xx 重定向', '4xx 客户端错误', '5xx 服务端错误', '关键词搜索'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <HttpStatus client:load />
  </article>
</BaseLayout>
