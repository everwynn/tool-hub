---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CssGenerator from '../../components/tools/CssGenerator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="CSS 生成器 - ToolHub" description="在线 CSS 渐变和阴影生成器，可视化调参，实时预览，一键复制 CSS 代码">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="css-generator" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🎨</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-800">前端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">CSS 生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">CSS 渐变（linear/radial/conic）和 box-shadow 可视化生成器，滑块调参、实时预览、预设模板、一键复制 CSS 代码。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['linear-gradient', 'radial-gradient', 'conic-gradient', 'box-shadow', 'inset', '预设模板'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <CssGenerator client:load />
  </article>
</BaseLayout>
