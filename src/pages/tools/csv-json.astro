---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsvJsonConverter from '../../components/tools/CsvJsonConverter.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="CSV JSON 转换 - ToolHub" description="在线 CSV 与 JSON 双向转换工具，支持自定义分隔符、首行表头">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="csv-json" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">📊</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">文本格式</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">CSV ↔ JSON 转换</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">CSV 和 JSON 双向转换，支持自定义分隔符（逗号/分号/Tab/竖线）、首行表头识别，完美处理含引号和逗号的字段。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['CSV → JSON', 'JSON → CSV', '自定义分隔符', '引号转义', '表头识别'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <CsvJsonConverter client:load />
  </article>
</BaseLayout>
