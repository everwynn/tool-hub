---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NginxConfigGenerator from '../../components/tools/NginxConfigGenerator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---

<BaseLayout
  title="Nginx 配置生成器 - ToolHub"
  description="可视化生成 Nginx 配置文件，支持反向代理、静态站点、HTTPS、负载均衡、WebSocket 等场景"
>
  <article class="max-w-7xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="nginx-config" type="tool" />

    <!-- 标题区 -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔀</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
              运维工具
            </span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">
              纯前端 · 无需后端
            </span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Nginx 配置生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">
        可视化生成 Nginx 配置文件。选择部署场景，填写参数，实时预览并一键复制或下载 <code class="px-1.5 py-0.5 rounded text-xs bg-gray-100 dark:bg-slate-800 text-accent">.conf</code> 文件。
      </p>

      <!-- 支持场景说明 -->
      <div class="flex flex-wrap gap-2 mt-4">
        {['反向代理', '静态站点', 'HTTPS + 证书', '负载均衡', 'WebSocket'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">
            {s}
          </span>
        ))}
      </div>
    </header>

    <!-- 生成器主体 -->
    <NginxConfigGenerator client:load />

    <!-- 使用说明 -->
    <section class="mt-12 p-6 rounded-xl bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800">
      <h2 class="text-base font-semibold text-gray-800 dark:text-slate-200 mb-4">使用说明</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-gray-600 dark:text-slate-400">
        <div>
          <h3 class="font-medium text-gray-700 dark:text-slate-300 mb-2">如何使用</h3>
          <ol class="space-y-1 list-decimal list-inside">
            <li>选择部署场景</li>
            <li>填写域名和端口等参数</li>
            <li>按需开启 Gzip / CORS 等增强选项</li>
            <li>点击"复制配置"或"下载 .conf"</li>
            <li>将配置文件放到 <code class="text-accent">/etc/nginx/conf.d/</code> 目录</li>
            <li>执行 <code class="text-accent">nginx -t && nginx -s reload</code></li>
          </ol>
        </div>
        <div>
          <h3 class="font-medium text-gray-700 dark:text-slate-300 mb-2">注意事项</h3>
          <ul class="space-y-1 list-disc list-inside">
            <li>使用前请确保 Nginx 已安装（<code class="text-accent">nginx -v</code>）</li>
            <li>HTTPS 场景需提前申请 SSL 证书（推荐 Let's Encrypt）</li>
            <li>负载均衡节点需确保后端服务正常运行</li>
            <li>生产环境请根据实际需求调整超时时间</li>
          </ul>
        </div>
        <div>
          <h3 class="font-medium text-gray-700 dark:text-slate-300 mb-2">配置文件位置</h3>
          <ul class="space-y-1">
            <li><code class="text-accent">/etc/nginx/nginx.conf</code> — 主配置</li>
            <li><code class="text-accent">/etc/nginx/conf.d/*.conf</code> — 站点配置</li>
            <li><code class="text-accent">nginx -t</code> — 检查配置语法</li>
            <li><code class="text-accent">nginx -s reload</code> — 热重载</li>
          </ul>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
