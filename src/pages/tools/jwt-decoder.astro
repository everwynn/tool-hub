---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JwtDecoder from '../../components/tools/JwtDecoder.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="JWT 解码器 - ToolHub" description="粘贴 JWT Token，自动解析 Header/Payload，查看算法、过期时间、签发时间等信息">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="jwt-decoder" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔑</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">后端工具</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 数据不上传</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">JWT 解码器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">粘贴 JWT Token，自动解析三段结构（Header / Payload / Signature），显示算法、过期时间、签发时间等字段。所有解析均在浏览器本地完成，不上传任何数据。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['Header 解析', 'Payload 解析', '过期状态检测', '时间戳转换', '颜色高亮三段'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <JwtDecoder client:load />
    <section class="mt-10 p-5 rounded-xl bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800 text-sm text-gray-600 dark:text-slate-400">
      <h2 class="font-semibold text-gray-800 dark:text-slate-200 mb-3">JWT 结构说明</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div><h3 class="font-medium text-red-600 dark:text-red-400 mb-1">Header（红色）</h3><p>声明令牌类型（typ: JWT）和签名算法（alg: HS256 / RS256 等）</p></div>
        <div><h3 class="font-medium text-purple-600 dark:text-purple-400 mb-1">Payload（紫色）</h3><p>包含声明（Claims），如 sub（主题）、exp（过期）、iat（签发时间）、自定义字段</p></div>
        <div><h3 class="font-medium text-cyan-600 dark:text-cyan-400 mb-1">Signature（青色）</h3><p>用密钥对 Header.Payload 进行签名，防止篡改。前端无法验证，需在服务端校验</p></div>
      </div>
    </section>
  </article>
</BaseLayout>
