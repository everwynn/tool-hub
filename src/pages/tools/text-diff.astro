---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TextDiff from '../../components/tools/TextDiff.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="文本对比 - ToolHub" description="在线文本 Diff 对比工具，逐行对比两段文本差异，LCS 算法，高亮增删改">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="text-diff" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">📝</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">文本格式</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">文本对比 (Diff)</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">逐行对比两段文本差异，使用 LCS 算法，高亮显示新增、删除、修改行，支持忽略空格和大小写。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['LCS 算法', '逐行对比', '增删改高亮', '忽略空格', '忽略大小写'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <TextDiff client:load />
  </article>
</BaseLayout>
