---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UrlCodec from '../../components/tools/UrlCodec.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="URL 编解码 - ToolHub" description="在线 URL 编解码工具，支持 encodeURIComponent / encodeURI，实时高亮显示被编码字符">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="url-codec" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔗</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">编码转换</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">URL 编解码</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">支持 encodeURIComponent / encodeURI 编码，实时高亮被编码字符，解码时自动解析 URL 结构和查询参数，附常见字符百分号编码速查表。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['encodeURIComponent', 'encodeURI', '查询参数编码', 'URL 结构解析', '实时高亮', '字符对照表'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <UrlCodec client:load />
  </article>
</BaseLayout>
