---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonToTs from '../../components/tools/JsonToTs.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="JSON 转 TypeScript - ToolHub" description="在线将 JSON 转换为 TypeScript interface/type，自动推断嵌套对象、数组元素合并、联合类型与可选字段，纯本地处理">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="json-to-ts" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🧩</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-800">前端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">JSON 转 TypeScript</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">粘贴 JSON 自动生成 TypeScript interface / type 声明，支持嵌套对象拆分、数组元素结构合并、联合类型与可选字段推断，全程浏览器本地处理。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['JSON', 'TypeScript', 'interface', '类型推断'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <JsonToTs client:load />
  </article>
</BaseLayout>
