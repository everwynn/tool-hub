---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChmodCalculator from '../../components/tools/ChmodCalculator.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="Linux chmod 权限计算器 - ToolHub" description="可视化计算 Linux 文件权限，支持八进制输入反推、常用预设，生成 chmod 命令">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="chmod" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔒</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">运维部署</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Linux chmod 权限计算器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">可视化勾选文件读/写/执行权限，自动计算八进制值和符号表示，生成 chmod 数字命令和符号命令，内置 755/644 等常用预设，支持八进制反推。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['可视化勾选', '八进制反推', '符号表示', '预设快选', 'chmod 命令', '安全建议'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <ChmodCalculator client:load />
  </article>
</BaseLayout>
