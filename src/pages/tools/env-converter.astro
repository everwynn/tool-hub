---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnvConverter from '../../components/tools/EnvConverter.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="环境变量格式转换 - ToolHub" description=".env / JSON / export / Docker --env 四种格式相互转换，支持互换输入输出">
  <article class="max-w-6xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="env-converter" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔄</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">CI/CD</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 数据不上传</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">环境变量格式转换</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">在 .env 文件、JSON 对象、Shell export 和 Docker --env 参数之间相互转换，自动过滤注释行，支持一键互换输入/输出格式。所有转换在浏览器本地完成。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['.env 文件', 'JSON 对象', 'Shell export', 'Docker --env', '注释过滤', '一键互换'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <EnvConverter client:load />
  </article>
</BaseLayout>
