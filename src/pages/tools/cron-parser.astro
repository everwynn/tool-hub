---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CronParser from '../../components/tools/CronParser.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="Cron 表达式生成器 - ToolHub" description="可视化编辑 Cron 表达式，实时预览下次执行时间，支持常用预设快速选择">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="cron-parser" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">⏰</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">运维部署</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 无需后端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Cron 表达式生成器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">可视化编辑 Cron 表达式（5字段标准格式），实时生成表达式并预览下次 8 次执行时间。支持手动输入和常用预设快速选择。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['可视化编辑', '手动输入', '10个常用预设', '下次8次执行时间', '人类可读描述'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <CronParser client:load />
    <section class="mt-10 p-5 rounded-xl bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800 text-sm text-gray-600 dark:text-slate-400">
      <h2 class="font-semibold text-gray-800 dark:text-slate-200 mb-3">Cron 格式说明（5字段）</h2>
      <div class="font-mono text-center text-lg text-gray-700 dark:text-slate-300 mb-4 tracking-widest">
        <span class="text-red-500">*</span>
        <span class="mx-3 text-purple-500">*</span>
        <span class="mx-3 text-blue-500">*</span>
        <span class="mx-3 text-amber-500">*</span>
        <span class="ml-3 text-green-500">*</span>
      </div>
      <div class="grid grid-cols-5 gap-2 text-center text-xs mb-4">
        <div class="text-red-500 dark:text-red-400">分钟<br/><span class="text-gray-400 dark:text-slate-600">0–59</span></div>
        <div class="text-purple-500 dark:text-purple-400">小时<br/><span class="text-gray-400 dark:text-slate-600">0–23</span></div>
        <div class="text-blue-500 dark:text-blue-400">日期<br/><span class="text-gray-400 dark:text-slate-600">1–31</span></div>
        <div class="text-amber-500 dark:text-amber-400">月份<br/><span class="text-gray-400 dark:text-slate-600">1–12</span></div>
        <div class="text-green-500 dark:text-green-400">星期<br/><span class="text-gray-400 dark:text-slate-600">0–6(日)</span></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {[['*', '任意值'], ['*/n', '每隔 n'], ['a-b', '范围 a 到 b'], ['a,b,c', '枚举值']].map(([expr, desc]) => (
          <div class="flex items-center gap-2">
            <code class="px-2 py-0.5 rounded bg-gray-200 dark:bg-slate-700 text-gray-700 dark:text-slate-300 font-mono">{expr}</code>
            <span>{desc}</span>
          </div>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
