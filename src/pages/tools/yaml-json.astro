---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YamlJsonConverter from '../../components/tools/YamlJsonConverter.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="YAML ↔ JSON 互转 - ToolHub" description="YAML 和 JSON 格式双向转换，支持 docker-compose / K8s 配置文件，含语法错误提示">
  <article class="max-w-7xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="yaml-json" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">⇄</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">云原生</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">YAML ↔ JSON 互转</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">YAML 和 JSON 格式双向转换，适用于 docker-compose、Kubernetes、GitHub Actions 等配置文件场景，支持一键互换方向。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['YAML→JSON', 'JSON→YAML', 'docker-compose', 'Kubernetes', '一键互换', '缩进可配'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <YamlJsonConverter client:load />
  </article>
</BaseLayout>
