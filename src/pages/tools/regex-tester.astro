---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegexTester from '../../components/tools/RegexTester.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="正则表达式测试器 - ToolHub" description="实时测试正则表达式，高亮显示匹配结果，支持捕获组、标志设置和 10 个常用预设">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="regex-tester" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔍</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">通用工具</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 无需后端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">正则表达式测试器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">实时测试正则表达式，高亮显示所有匹配位置，支持捕获分组详情、g/i/m/s 标志设置，以及邮箱、手机号、URL 等 10 个常用预设。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['实时高亮匹配', '捕获组详情', 'g/i/m/s 标志', '10个常用预设', '匹配位置统计'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <RegexTester client:load />
  </article>
</BaseLayout>
