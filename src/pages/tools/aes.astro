---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AesToolkit from '../../components/tools/AesToolkit.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="AES 加解密 - ToolHub" description="在线 AES-GCM / AES-CBC 加解密工具，支持密码派生和原始密钥，全部在浏览器本地运算">
  <article class="max-w-3xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="aes" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔐</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800">安全</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端 · 数据不上传</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">AES 加解密</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">支持 AES-GCM / AES-CBC 模式，128 / 192 / 256 位密钥，PBKDF2 密码派生或直接使用 Hex 原始密钥，输出 Base64 或 Hex，全部通过 Web Crypto API 在浏览器本地完成。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['AES-GCM', 'AES-CBC', '128/192/256 bit', 'PBKDF2 密码派生', 'Hex 密钥', 'Base64/Hex 输出'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <AesToolkit client:load />
  </article>
</BaseLayout>
