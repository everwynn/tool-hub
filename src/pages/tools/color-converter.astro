---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColorConverter from '../../components/tools/ColorConverter.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="颜色格式转换器 - ToolHub" description="HEX / RGB / RGBA / HSL / HSV / CMYK 颜色格式互转，可视化拾色器，色板预设">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="color-converter" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🎨</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-800">前端开发</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯前端</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">颜色格式转换器</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">通过拾色器、HEX 输入或 RGB/HSL 滑块选取颜色，自动转换为 HEX、RGBA、HSL、HSLA、HSV、CMYK、CSS 变量、Tailwind 格式，支持透明度调节和预设色板。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['HEX', 'RGB/RGBA', 'HSL/HSLA', 'HSV', 'CMYK', 'CSS变量', 'Tailwind', '透明度'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <ColorConverter client:load />
  </article>
</BaseLayout>
