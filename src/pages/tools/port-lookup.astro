---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortLookup from '../../components/tools/PortLookup.vue';
import PageShareBar from '../../components/PageShareBar.vue';
---
<BaseLayout title="常用端口速查 - ToolHub" description="Linux/服务器常用端口速查表，含数据库、Web、邮件、运维等分类，标注危险端口">
  <article class="max-w-5xl mx-auto px-6 py-10">
    <PageShareBar client:load slug="port-lookup" type="tool" />
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🔌</span>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">运维工具</span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800">纯静态</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">常用端口速查</h1>
        </div>
      </div>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">整理了 MySQL、Redis、Nginx、Docker、Kafka 等 35+ 常用服务端口，含协议类型、分类和安全风险标注，支持搜索和分类筛选。</p>
      <div class="flex flex-wrap gap-2 mt-4">
        {['TCP/UDP', '数据库', 'Web', '运维', '消息队列', '安全标注'].map(s => (
          <span class="px-3 py-1 text-xs rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-700">{s}</span>
        ))}
      </div>
    </header>
    <PortLookup client:load />
  </article>
</BaseLayout>
